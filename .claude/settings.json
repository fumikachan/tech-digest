{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run tech-digest *)",
      "Bash(uv sync *)",
      "Bash(uv tree *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(aws *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.py\""
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "env": { "ENABLE_STOP_REVIEW": "0" }
}
