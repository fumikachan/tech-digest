# このファイルを .env にコピーして値を入れる（.env はコミットしない）
#   cp .env.example .env

# compose の PostgreSQL のパスワード。ランダムな値にする: openssl rand -hex 16
POSTGRES_PASSWORD=

# Qiita のアクセストークン（任意）。なしだと 60 リクエスト/時の制限
QIITA_TOKEN=

# 手元に公開する PostgreSQL のポート（任意）。5432 がほかと重なるときだけ変える
# DB_PORT=5432

# 手元に公開する DynamoDB Local のポート（任意）。8000 がほかと重なるときだけ変える
# DYNAMODB_PORT=8000
